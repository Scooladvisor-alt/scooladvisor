{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "moderator"
      ],
      "default": "user"
    },
    "profile_avatar": {
      "type": "string",
      "description": "Avatar s\u00e9lectionn\u00e9 par l'utilisateur"
    },
    "study_level": {
      "type": "string",
      "enum": [
        "college",
        "lycee",
        "universite",
        "ecole_commerce",
        "ecole_ingenieur",
        "ecole_privee",
        "autre"
      ],
      "description": "Niveau d'\u00e9tude de l'utilisateur"
    },
    "onboarding_done": {
      "type": "boolean",
      "default": false,
      "description": "Si l'utilisateur a compl\u00e9t\u00e9 l'onboarding"
    },
    "is_banned": {
      "type": "boolean",
      "default": false
    },
    "banned_until": {
      "type": "string",
      "format": "date-time"
    },
    "warnings_count": {
      "type": "integer",
      "default": 0
    },
    "linkedin_url": {
      "type": "string",
      "description": "URL du profil LinkedIn de l'utilisateur"
    },
    "career_entries": {
      "type": "array",
      "description": "Parcours de l'utilisateur (formations et exp\u00e9riences)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "education",
              "experience"
            ],
            "description": "Type d'entr\u00e9e : formation ou exp\u00e9rience"
          },
          "title": {
            "type": "string",
            "description": "Intitul\u00e9 (dipl\u00f4me, poste)"
          },
          "organization": {
            "type": "string",
            "description": "\u00c9tablissement ou entreprise"
          },
          "period": {
            "type": "string",
            "description": "P\u00e9riode (ex: 2020 - 2023)"
          },
          "description": {
            "type": "string",
            "description": "Description optionnelle"
          }
        }
      }
    }
  },
  "required": [
    "profile_avatar",
    "study_level",
    "banned_until"
  ]
}