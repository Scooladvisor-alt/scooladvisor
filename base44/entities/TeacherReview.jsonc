{
  "name": "TeacherReview",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "description": "ID du professeur"
    },
    "workload": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "Charge de travail (0-5)"
    },
    "friendliness": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "Amabilit\u00e9 (0-5)"
    },
    "teaching_method": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "M\u00e9thode d'enseignement (0-5)"
    },
    "grading_severity": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "S\u00e9v\u00e9rit\u00e9 de notation (0-5)"
    },
    "total_rating": {
      "type": "number",
      "description": "Note totale sur 20"
    },
    "comment": {
      "type": "string",
      "description": "Commentaire"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false,
      "description": "Avis anonyme"
    },
    "is_former_student": {
      "type": "boolean",
      "default": false,
      "description": "Si l'auteur est un ancien \u00e9l\u00e8ve"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "pending",
        "rejected",
        "hidden",
        "reported"
      ],
      "default": "published"
    },
    "report_count": {
      "type": "integer",
      "default": 0
    },
    "like_count": {
      "type": "integer",
      "default": 0,
      "description": "Nombre de likes"
    },
    "edit_count": {
      "type": "integer",
      "default": 0,
      "description": "Nombre de modifications effectu\u00e9es"
    },
    "author_name": {
      "type": "string",
      "description": "Nom de l'auteur (cache)"
    },
    "author_avatar": {
      "type": "string",
      "description": "Avatar de l'auteur (cache)"
    }
  },
  "required": [
    "teacher_id",
    "workload",
    "friendliness",
    "teaching_method",
    "grading_severity",
    "comment"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}