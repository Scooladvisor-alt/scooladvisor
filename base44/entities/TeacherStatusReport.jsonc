{
  "name": "TeacherStatusReport",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "description": "ID du professeur"
    },
    "reporter_email": {
      "type": "string",
      "description": "Email du signaleur"
    },
    "reporter_id": {
      "type": "string",
      "description": "ID du signaleur"
    },
    "reason": {
      "type": "string",
      "description": "Raison (professeur ne fait plus partie de l'\u00e9tablissement)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processed"
      ],
      "default": "pending"
    },
    "teacher_name": {
      "type": "string",
      "description": "Nom du professeur signal\u00e9"
    }
  },
  "required": [
    "teacher_id",
    "reporter_email",
    "reporter_id"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}