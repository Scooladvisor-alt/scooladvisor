{
  "name": "School",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de l'\u00e9tablissement"
    },
    "type": {
      "type": "string",
      "enum": [
        "college",
        "lycee",
        "universite",
        "ecole_privee",
        "ecole_commerce",
        "ecole_ingenieur"
      ],
      "description": "Type d'\u00e9tablissement"
    },
    "address": {
      "type": "string",
      "description": "Adresse compl\u00e8te"
    },
    "city": {
      "type": "string",
      "description": "Ville"
    },
    "region": {
      "type": "string",
      "description": "R\u00e9gion (utilis\u00e9 pour filtre International)"
    },
    "average_rating": {
      "type": "number",
      "description": "Note moyenne calcul\u00e9e"
    },
    "review_count": {
      "type": "integer",
      "description": "Nombre total d'avis"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "banned"
      ],
      "default": "pending",
      "description": "Statut de validation"
    },
    "is_hidden": {
      "type": "boolean",
      "default": false,
      "description": "Si l'\u00e9tablissement est masqu\u00e9 (non visible sur le site)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description optionnelle"
    }
  },
  "required": [
    "name",
    "type",
    "address",
    "city"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}