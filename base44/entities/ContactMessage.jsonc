{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de l'exp\u00e9diteur"
    },
    "email": {
      "type": "string",
      "description": "Email de l'exp\u00e9diteur"
    },
    "subject": {
      "type": "string",
      "description": "Sujet du message"
    },
    "message": {
      "type": "string",
      "description": "Contenu du message"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "read",
        "resolved"
      ],
      "default": "pending",
      "description": "Statut du message"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description optionnelle"
    }
  },
  "required": [
    "name",
    "email",
    "subject",
    "message"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}