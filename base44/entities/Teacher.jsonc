{
  "name": "Teacher",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "ID de l'\u00e9tablissement"
    },
    "name": {
      "type": "string",
      "description": "Nom du professeur"
    },
    "subject": {
      "type": "string",
      "description": "Mati\u00e8re enseign\u00e9e"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo du professeur"
    },
    "average_rating": {
      "type": "number",
      "description": "Note moyenne sur 20"
    },
    "workload_avg": {
      "type": "number",
      "description": "Moyenne charge de travail"
    },
    "friendliness_avg": {
      "type": "number",
      "description": "Moyenne amabilit\u00e9"
    },
    "teaching_avg": {
      "type": "number",
      "description": "Moyenne m\u00e9thode d'enseignement"
    },
    "grading_avg": {
      "type": "number",
      "description": "Moyenne s\u00e9v\u00e9rit\u00e9 notation"
    },
    "review_count": {
      "type": "integer",
      "description": "Nombre d'avis"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "status_report_count": {
      "type": "integer",
      "default": 0,
      "description": "Nombre de signalements de statut"
    },
    "is_former": {
      "type": "boolean",
      "default": false,
      "description": "Ancien professeur"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Si le professeur est supprim\u00e9 (corbeille)"
    },
    "is_hidden": {
      "type": "boolean",
      "default": false,
      "description": "Si le professeur est masqu\u00e9 (visible uniquement en mod\u00e9ration)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description optionnelle"
    }
  },
  "required": [
    "school_id",
    "name",
    "subject"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}