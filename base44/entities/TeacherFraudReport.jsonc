{
  "name": "TeacherFraudReport",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "description": "ID du professeur"
    },
    "reporter_email": {
      "type": "string",
      "description": "Email du signaleur"
    },
    "reporter_id": {
      "type": "string",
      "description": "ID du signaleur"
    },
    "reason": {
      "type": "string",
      "description": "Raison du signalement (faux professeur)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processed"
      ],
      "default": "pending"
    },
    "teacher_name": {
      "type": "string",
      "description": "Nom du professeur signal\u00e9"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description optionnelle"
    }
  },
  "required": [
    "teacher_id",
    "reporter_email",
    "reporter_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}