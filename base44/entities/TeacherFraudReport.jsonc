{
  "name": "TeacherFraudReport",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "description": "ID du professeur"
    },
    "reporter_email": {
      "type": "string",
      "description": "Email du signaleur"
    },
    "reporter_id": {
      "type": "string",
      "description": "ID du signaleur"
    },
    "reason": {
      "type": "string",
      "description": "Raison du signalement (faux professeur)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processed"
      ],
      "default": "pending"
    },
    "teacher_name": {
      "type": "string",
      "description": "Nom du professeur signal\u00e9"
    }
  },
  "required": [
    "teacher_id",
    "reporter_email",
    "reporter_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}