{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur destinataire"
    },
    "title": {
      "type": "string",
      "description": "Titre de la notification"
    },
    "message": {
      "type": "string",
      "description": "Contenu de la notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "success",
        "error",
        "like",
        "report",
        "system"
      ],
      "default": "info",
      "description": "Type de notification"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Si la notification a \u00e9t\u00e9 lue"
    },
    "review_id": {
      "type": "string",
      "description": "ID de l'avis li\u00e9 (optionnel)"
    },
    "link": {
      "type": "string",
      "description": "Lien optionnel"
    }
  },
  "required": [
    "user_email",
    "title",
    "message"
  ],
  "rls": {
    "read": {
      "rule": "user_email = auth.email || auth.role = 'admin'"
    },
    "update": {
      "rule": "user_email = auth.email || auth.role = 'admin'"
    },
    "delete": {
      "rule": "user_email = auth.email || auth.role = 'admin'"
    },
    "create": {
      "rule": "auth.id != null"
    }
  }
}