{
  "name": "TeacherLoveNote",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "description": "ID du professeur"
    },
    "message": {
      "type": "string",
      "description": "Le petit mot doux"
    },
    "author_email": {
      "type": "string",
      "description": "Email de l'auteur"
    },
    "author_id": {
      "type": "string",
      "description": "ID de l'auteur"
    },
    "author_name": {
      "type": "string",
      "description": "Nom de l'auteur"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false,
      "description": "Si le message est anonyme"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description optionnelle"
    }
  },
  "required": [
    "teacher_id",
    "message",
    "author_email",
    "author_id"
  ]
}