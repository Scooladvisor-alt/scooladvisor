{
  "name": "BanAppeal",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur banni"
    },
    "user_id": {
      "type": "string",
      "description": "ID de l'utilisateur banni"
    },
    "appeal_message": {
      "type": "string",
      "description": "Message de contestation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "moderator_decision": {
      "type": "string",
      "description": "D\u00e9cision du mod\u00e9rateur"
    }
  },
  "required": [
    "user_email",
    "user_id",
    "appeal_message"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}