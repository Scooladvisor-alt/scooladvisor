{
  "name": "SchoolReport",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "ID de l'\u00e9tablissement signal\u00e9"
    },
    "reporter_email": {
      "type": "string",
      "description": "Email du signaleur"
    },
    "reporter_id": {
      "type": "string",
      "description": "ID du signaleur"
    },
    "reason": {
      "type": "string",
      "enum": [
        "fake_school",
        "inappropriate",
        "duplicate",
        "other"
      ],
      "description": "Raison du signalement"
    },
    "details": {
      "type": "string",
      "description": "D\u00e9tails du signalement"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "school_name": {
      "type": "string",
      "description": "Nom de l'\u00e9tablissement signal\u00e9"
    }
  },
  "required": [
    "school_id",
    "reporter_email",
    "reporter_id",
    "reason"
  ],
  "rls": {
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}