{
  "name": "NationalMessage",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "description": "Contenu du message national"
    },
    "color": {
      "type": "string",
      "enum": [
        "pink",
        "purple",
        "blue",
        "green",
        "orange",
        "red"
      ],
      "description": "Couleur du message"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "is_edited": {
      "type": "boolean",
      "default": false,
      "description": "Si le message a \u00e9t\u00e9 modifi\u00e9"
    },
    "edit_count": {
      "type": "integer",
      "default": 0,
      "description": "Nombre de modifications effectu\u00e9es"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Si le message est supprim\u00e9 (corbeille)"
    }
  },
  "required": [
    "message",
    "color"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.is_deleted": false
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}